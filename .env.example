# Copy to .env for local development. Never commit .env.

# Neon pooled connection string (application traffic)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Neon direct connection string (migrations only; no -pooler in hostname)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Flask secret key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Optional password gate for a single-user deployment. Leave blank to disable.
APP_PASSWORD=

# Optional public URL, used in PWA metadata and deployment checks.
PUBLIC_BASE_URL=http://localhost:5000

FLASK_APP=wsgi.py
FLASK_ENV=development
